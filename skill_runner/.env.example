# ── skill_runner 設定：複製成 .env 再填 ──  cp .env.example .env

# 共享密鑰，要跟 mcp_server/.env 的 SKILL_RUNNER_TOKEN 一致（mcp_server 是唯一
# 呼叫端；skill-net 網路拓樸本身才是主要防線，這個密鑰只是順手加的第二層）
INTERNAL_TOKEN=

# 同時最多幾個技能一起執行、單次執行逾時上限（秒）——都是同一個容器共用的
# cgroup 資源預算，數字大不代表安全，只是併發/等待的取捨
SKILL_RUNNER_MAX_CONCURRENT=4
SKILL_RUNNER_MAX_TIMEOUT_S=30
